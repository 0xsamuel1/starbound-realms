# Initialization performed, in order
# - galaxy-map: initialize(admin, grid_size=8)
# - resources:  initialize(admin, iron, energy, plasma), set_galaxy_map(admin, galaxy_map)
# - fleet:      initialize(admin, resources, galaxy_map)
# - battle:     initialize(admin, galaxy_map, fleet)
# - fleet:      set_battle_contract(admin, battle)
# - galaxy-map: set_battle_contract(admin, battle)
# - each asset: set_admin(new_admin=resources)

