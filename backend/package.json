    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "2.0.16",
    "supertest": "6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
